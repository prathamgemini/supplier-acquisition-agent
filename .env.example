# Copy this file to .env and fill in your values (setup.bat does the copy for you).
# .env is git-ignored: never share it or commit it.

# === 1. AI model (required) ==================================================
# Create a free key at https://console.groq.com/keys and paste it after the = sign.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b
# Qwen thinking depth for the analyst and critic: none | low | medium | high.
# Thinking uses many more output tokens, so keep "none" on Groq's free tier.
GROQ_REASONING=none
# Parallel AI calls. 2 suits the free tier; raise to 6-8 on Groq's Developer tier.
LLM_CONCURRENCY=2

# === 2. Sending real emails (optional) =======================================
# true  = dry run: emails are written and reviewed but never sent (safe default)
# false = approved emails are really sent, using the service configured below
ENABLE_DRY_RUN=true

# The address your emails come from.
FROM_EMAIL=

# While testing, put YOUR OWN address here: every email is then delivered to you
# instead of the lead. Leave it empty only when you are ready to email real people.
TEST_RECIPIENT=

# --- Option A: Gmail or any other mailbox (simplest) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address,
# SMTP_PASSWORD=a 16-character "App password" (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Option B: SendGrid (higher volume, open/click tracking) ---
# Used only if SMTP_HOST above is empty.
SENDGRID_API_KEY=